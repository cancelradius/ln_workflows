# Main build container definition file
# Build from project root
Bootstrap: oras
From: ghcr.io/cancelradius/orca_6_1_1_ubuntu_22.04:1.0.0

%environment
    QUACC_ORCA_CMD=$ORCA_CMD
    PATH="/root/.local/bin:$PATH"
    PYTHONUNBUFFERED=1

%files
    src /app/src
    poetry.lock /app/poetry.lock
    pyproject.toml /app/pyproject.toml

%post
    # Force stop build on error
    set -e

    # Install Python
    apt-get update && apt-get install -y --no-install-recommends \
        curl \\
        build-essential \
        python3 \
        python3-pip \
        python3-dev \
        && rm -rf /var/lib/apt/lists/*

    # Build ln_workflows package
    cd /app
    pip install build && python -m build --wheel .

    # Try to install built ln_workflows package
    pip install /app/dist/ln_workflows-*.whl

%startscript
    #!/bin/bash

    unset -v MONGO_URI
    if [ -f "$HOME/.lnw_env" ]; then
        set -a
        . "$HOME/.lnw_env"
        set +a
    fi

    if [[ -z "$MONGO_URI" ]]; then
        read -rsp "First-time startup, enter your MongoDB SRV connection string:" MONGO_URI
        export MONGO_URI
        umask 077
        printf 'MONGO_URI=%q\n' "$MONGO_URI" >> "$HOME/.lnw_env"
        export MONGO_URI
    fi

%runscript


%labels
    Desc Containerized applications for quantum chemistry workflow management
    Author felix.rotter@mail.utoronto.ca
    Version v1.0.0
